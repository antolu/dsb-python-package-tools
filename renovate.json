{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base"
  ],
  "automerge": false,
  "managers": [
    {
      "managerName": "pep621",
      "fileMatch": [
        "(^|/)pyproject\\.toml$"
      ]
    },
    {
      "managerName": "gitSubmodules"
    },
    {
      "managerName": "pre-commit"
    }
  ],
  "packageRules": [
    {
      "matchManagers": [
        "pep621"
      ],
      "commitMessagePrefix": "chore(deps):",
      "registryUrls": [
        "https://acc-py-repo.cern.ch/repository/vr-py-releases/simple/"
      ]
    },
    {
      "matchManagers": [
        "pre-commit"
      ],
      "commitMessagePrefix": "chore(hooks):",
      "registryUrls": [
        "https://acc-py-repo.cern.ch/repository/vr-py-releases/simple/"
      ]
    },
    {
      "matchManagers": [
        "gitSubmodules"
      ],
      "versioning": "semver",
      "commitMessagePrefix": "chore(submodules):"
    }
  ]
}
