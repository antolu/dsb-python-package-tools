{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base"
  ],
  "automerge": false,
  "enabledManagers": [
    "pep621",
    "git-submodules",
    "pre-commit"
  ],
  "pep621": {
    "managerFilePatterns": [
      "/(^|/)pyproject\\.toml$/"
    ]
  },
  "packageRules": [
    {
      "matchManagers": [
        "pep621"
      ],
      "commitMessagePrefix": "chore(deps):",
      "registryUrls": [
        "https://acc-py-repo.cern.ch/repository/vr-py-releases/simple/"
      ]
    },
    {
      "matchManagers": [
        "pre-commit"
      ],
      "commitMessagePrefix": "chore(hooks):",
      "registryUrls": [
        "https://acc-py-repo.cern.ch/repository/vr-py-releases/simple/"
      ]
    },
    {
      "matchManagers": [
        "git-submodules"
      ],
      "versioning": "semver",
      "commitMessagePrefix": "chore(submodules):"
    }
  ]
}
