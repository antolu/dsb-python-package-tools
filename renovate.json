{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base"
  ],
  "automerge": false,
  "managers": [
    {
      "managerName": "pep621",
      "fileMatch": [
        "(^|/)pyproject\\.toml$"
      ]
    },
    {
      "managerName": "gitSubmodules"
    },
    {
      "managerName": "pre-commit"
    }
  ],
  "packageRules": [
    {
      "matchManagers": [
        "gitSubmodules"
      ],
      "versioning": "semver"
    }
  ]
}
