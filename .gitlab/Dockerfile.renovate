ARG RENOVATE_TAG
FROM renovate/renovate:${RENOVATE_TAG}

USER root

RUN curl -sS "https://cafiles.cern.ch/cafiles/certificates/CERN%20Root%20Certification%20Authority%202.crt" \
      -o /tmp/cern-root.der \
 && openssl x509 -inform DER -in /tmp/cern-root.der \
      -out /usr/local/share/ca-certificates/cern-root.crt \
 && rm /tmp/cern-root.der \
 && curl -sS "https://cafiles.cern.ch/cafiles/certificates/CERN%20Certification%20Authority(1).crt" \
      -o /usr/local/share/ca-certificates/cern-int.crt \
 && update-ca-certificates

# The slim renovate image does not ship pip or ensurepip. Install via apt-get.
# Use the slim (unversioned-suffix) image, NOT -full — -full is much larger and unnecessary.
RUN apt-get update && apt-get install -y --no-install-recommends python3-pip && rm -rf /var/lib/apt/lists/*

# Install dsb-devtools from the local source tree (build context = repo root).
# This avoids the chicken-and-egg problem of needing a released package before
# building the image — the image always contains exactly what's in the repo.
COPY . /tmp/dsb-devtools
RUN pip install \
      --break-system-packages \
      --index-url https://acc-py-repo.cern.ch/repository/vr-py-releases/simple/ \
      --extra-index-url https://pypi.org/simple/ \
      --trusted-host acc-py-repo.cern.ch \
      /tmp/dsb-devtools

USER 12021

ENV SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
ENV NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt
